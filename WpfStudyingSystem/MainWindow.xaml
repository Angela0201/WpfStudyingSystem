<Window x:Class="WpfStudyingSystem.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfStudyingSystem"
        xmlns:res="clr-namespace:WpfStudyingSystem.Resources"
        mc:Ignorable="d"
        Title="{x:Static res:Strings.AppTitle}" Height="600" Width="900" MinHeight="520" MinWidth="860" SizeToContent="WidthAndHeight">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="3*"/>
            <ColumnDefinition Width="3*"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Margin="0,0,10,0" MouseDown="CoursesArea_MouseDown">
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <GroupBox Grid.Row="0"
                      Header="{x:Static res:Strings.UI_CoursesSelectable}" 
                      Margin="0,0,0,8">
                <ListBox x:Name="CoursesList"
                         SelectionChanged="CoursesList_SelectionChanged"
                         ItemsSource="{Binding Courses}"
                         DisplayMemberPath="Name">
                </ListBox>
            </GroupBox>

            <StackPanel Grid.Row="1" Orientation="Horizontal">
                <Button Content="{x:Static res:Strings.Ui_Create}" Margin="0,0,5,0" Click="CoursesCreate_Click"/>
                <Button Content="{x:Static res:Strings.Ui_Delete}" Margin="0,0,5,0" Click="CoursesDelete_Click"/>
                <Button Content="{x:Static res:Strings.Ui_Redact}" Click="CoursesRedact_Click"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Column="1" Margin="0,0,10,0" MouseDown="AssignmentsArea_MouseDown">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <GroupBox Grid.Row="0"
                      Header="{x:Static res:Strings.UI_TeacherName}"
                      Margin="0,0,0,8">
                <TextBlock x:Name="TeacherNameText" Margin="6,4"/>
            </GroupBox>

            <GroupBox Grid.Row="1"
                      Header="{x:Static res:Strings.UI_StudentsList}"
                      Margin="0,0,0,8">
                <ListBox x:Name="StudentsList"
                         ItemsSource="{Binding CourseStudents}"
                         DisplayMemberPath="FullName"
                         SelectionChanged="StudentsList_SelectionChanged"/>
            </GroupBox>

            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,8">
                <Button Content="{x:Static res:Strings.Ui_Add}" Margin="0,0,5,0" Click="StudentsAdd_Click"/>
                <Button Content="{x:Static res:Strings.Ui_Delete}" Click="StudentsDelete_Click"/>
            </StackPanel>

            <Button x:Name="FilterButton"
                    Grid.Row="3"
                    Content="{x:Static res:Strings.Ui_Filter}"
                    Margin="0,0,0,8"
                    Height="28"
                    Click="Filter_Click"/>

            <GroupBox Grid.Row="4"
                      Header="{x:Static res:Strings.UI_AssignmentsListSelectable}"
                      Margin="0,0,0,8">
                <ListBox x:Name="AssignmentsList"
                         SelectionChanged="AssignmentsList_SelectionChanged"
                         ItemsSource="{Binding Assignments}"
                         DisplayMemberPath="Name"/>
            </GroupBox>

            <StackPanel Grid.Row="5" Orientation="Horizontal">
                <Button Content="{x:Static res:Strings.Ui_Create}" Margin="0,0,5,0" Click="AssignmentsCreate_Click"/>
                <Button Content="{x:Static res:Strings.Ui_Delete}" Margin="0,0,5,0" Click="AssignmentsDelete_Click"/>
                <Button Content="{x:Static res:Strings.Ui_Redact}" Click="AssignmentsRedact_Click"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <GroupBox Grid.Row="0"
                      Header="{x:Static res:Strings.Ui_StudentInfo}"
                      Margin="0,0,0,8">
                <TextBlock x:Name="StudentInfoText" Margin="6,4" TextWrapping="Wrap"/>
            </GroupBox>

            <GroupBox Grid.Row="1"
                      Header="{x:Static res:Strings.Ui_AssignmentInfo}"
                      Margin="0,0,0,8">
                <TextBlock x:Name="AssignmentInfoText" Margin="6,4" TextWrapping="Wrap"/>
            </GroupBox>

            <GroupBox Grid.Row="2"
                      Header="{x:Static res:Strings.UI_GradesList}"
                      Margin="0,0,0,8">
                <ListBox x:Name="GradesList"/>
            </GroupBox>

            <Button Grid.Row="3"
                    Content="{x:Static res:Strings.Ui_SetPoints}"
                    Height="28"
                    Margin="0,0,0,8"
                    Click="GradesSetPoints_Click"/>

            <Button Grid.Row="4"
                    Content="{x:Static res:Strings.Ui_Export}"
                    Height="28"
                    HorizontalAlignment="Stretch"
                    Click="Export_Click"/>
        </Grid>
        
        <Border x:Name="AssignmentDialogOverlay"
        Grid.ColumnSpan="3"
        Background="#66000000"
        Visibility="Collapsed">

            <Border Background="White"
            BorderBrush="#FFB0B0B0"
            BorderThickness="1"
            Padding="12"
            Width="520"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock x:Name="AssignmentDialogTitle"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Margin="0,0,0,10"/>

                    <Grid Grid.Row="1" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Text="{x:Static res:Strings.Ui_Name}"/>
                        <TextBox Grid.Row="0" Grid.Column="1" x:Name="AssignmentNameBox" Margin="8,0,0,6"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Text="{x:Static res:Strings.Ui_DueDate}"/>
                        <DatePicker Grid.Row="1" Grid.Column="1" x:Name="AssignmentDatePicker" Margin="8,0,0,6"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Text="{x:Static res:Strings.Ui_Type}"/>
                        <ComboBox Grid.Row="2" Grid.Column="1" x:Name="AssignmentTypeBox" Margin="8,0,0,0"/>
                    </Grid>

                    <Grid Grid.Row="2" Margin="0,0,0,10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="{x:Static res:Strings.Ui_Description}" Margin="0,0,0,6"/>
                        <TextBox Grid.Row="1"
                         x:Name="AssignmentDescriptionBox"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         Height="110"/>
                    </Grid>

                    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="{x:Static res:Strings.Ui_Ok}" Width="90" Margin="0,0,8,0" Click="AssignmentDialogOk_Click"/>
                        <Button Content="{x:Static res:Strings.Ui_Cancel}" Width="90" Click="AssignmentDialogCancel_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Border>
        
        <Border x:Name="CourseDialogOverlay"
        Grid.ColumnSpan="3"
        Background="#66000000"
        Visibility="Collapsed">

            <Border Background="White"
            BorderBrush="#FFB0B0B0"
            BorderThickness="1"
            Padding="12"
            Width="420"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock x:Name="CourseDialogTitle"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Margin="0,0,0,10"/>

                    <Grid Grid.Row="1" Margin="0,0,0,10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Text="{x:Static res:Strings.Ui_Name}"/>
                        <TextBox Grid.Row="0" Grid.Column="1" x:Name="CourseNameBox" Margin="8,0,0,0"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Margin="0,8,0,0" Text="{x:Static res:Strings.Ui_TeacherFullName}"/>
                        <TextBox Grid.Row="1" Grid.Column="1" x:Name="CourseTeacherNameBox" Margin="8,8,0,0"/>
                    </Grid>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="{x:Static res:Strings.Ui_Ok}" Width="90" Margin="0,0,8,0" Click="CourseDialogOk_Click"/>
                        <Button Content="{x:Static res:Strings.Ui_Cancel}" Width="90" Click="CourseDialogCancel_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Border>
        
        <Border x:Name="StudentDialogOverlay"
        Grid.ColumnSpan="3"
        Background="#66000000"
        Visibility="Collapsed">

            <Border Background="White"
            BorderBrush="#FFB0B0B0"
            BorderThickness="1"
            Padding="12"
            Width="420"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock x:Name="StudentDialogTitle"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Margin="0,0,0,10"/>

                    <Grid Grid.Row="1" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Text="{x:Static res:Strings.Ui_FirstName}"/>
                        <TextBox Grid.Row="0" Grid.Column="1" x:Name="StudentFirstNameBox" Margin="8,0,0,6"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Text="{x:Static res:Strings.Ui_LastName}"/>
                        <TextBox Grid.Row="1" Grid.Column="1" x:Name="StudentLastNameBox" Margin="8,0,0,6"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Text="{x:Static res:Strings.Ui_Age}"/>
                        <TextBox Grid.Row="2" Grid.Column="1" x:Name="StudentAgeBox" Margin="8,0,0,0"/>
                    </Grid>

                    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="{x:Static res:Strings.Ui_Ok}" Width="90" Margin="0,0,8,0" Click="StudentDialogOk_Click"/>
                        <Button Content="{x:Static res:Strings.Ui_Cancel}" Width="90" Click="StudentDialogCancel_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Border>

        <Border x:Name="GradeDialogOverlay"
        Grid.ColumnSpan="3"
        Background="#66000000"
        Visibility="Collapsed">

            <Border Background="White"
            BorderBrush="#FFB0B0B0"
            BorderThickness="1"
            Padding="12"
            Width="420"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock x:Name="GradeDialogTitle"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Margin="0,0,0,10"/>

                    <Grid Grid.Row="1" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                           VerticalAlignment="Center"
                           Text="{x:Static res:Strings.Ui_Points}"/>
                        <TextBox Grid.Column="1"
                         x:Name="GradePointsBox"
                         Margin="8,0,0,0"/>
                    </Grid>

                    <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">
                        <Button Content="{x:Static res:Strings.Ui_Ok}"
                        Width="90"
                        Margin="0,0,8,0"
                        Click="GradeDialogOk_Click"/>
                        <Button Content="{x:Static res:Strings.Ui_Cancel}"
                        Width="90"
                        Click="GradeDialogCancel_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Border>
    </Grid>
</Window>